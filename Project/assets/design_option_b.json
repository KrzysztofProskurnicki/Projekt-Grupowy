{
    "design_option": "B",
    "name": "Security Score Gauge (High Fidelity)",
    "version": "2.0",
    "description": "A premium, neon-styled semicircle gauge with advanced transparency effects, gradients, and dynamic feedback.",
    "layout": {
        "dimensions": {
            "min_width": "320px",
            "min_height": "240px",
            "padding": "20px"
        },
        "geometry": {
            "shape": "Semicircle (180 degrees)",
            "orientation": "Arch upwards (180 to 0 degrees)",
            "center_point_offset_y": "50px from bottom"
        }
    },
    "visual_components": {
        "background_track": {
            "visible": true,
            "z_index": 1,
            "style": {
                "color": "#2c2c2e",
                "description": "Dark grey base track",
                "width": "Dynamic (calculated relative to radius)",
                "cap_style": "Round"
            },
            "outline": {
                "visible": true,
                "color": "#ffffff",
                "opacity": 0.3,
                "width": "1px or 2px",
                "description": "Subtle white outline defining the track shape",
                "rendering_hint": "Draw stroked path over the background fill"
            }
        },
        "value_arc": {
            "visible": true,
            "z_index": 2,
            "description": "The main indicator bar showing the current score",
            "gradient": {
                "type": "Linear",
                "stops": [
                    {
                        "offset": 0.0,
                        "color": "#ff453a",
                        "name": "Neon Red"
                    },
                    {
                        "offset": 0.5,
                        "color": "#ffd60a",
                        "name": "Neon Yellow"
                    },
                    {
                        "offset": 1.0,
                        "color": "#30d158",
                        "name": "Neon Green"
                    }
                ]
            },
            "glow_effect": {
                "enabled": true,
                "type": "Outer Glow",
                "color_logic": "Dynamic based on score range",
                "opacity": 0.6,
                "blur_radius": "20px",
                "spread": "Wide"
            }
        },
        "needle": {
            "visible": true,
            "z_index": 3,
            "style": "Modern Gradient Fader",
            "shape": {
                "type": "Rounded Rectangle / Tapered",
                "width": "4px",
                "length": "Inner Radius - 8px"
            },
            "fill": {
                "type": "Linear Gradient",
                "direction": "From Pivot (Center) to Tip",
                "stops": [
                    {
                        "offset": 0.0,
                        "color": "transparent",
                        "opacity": 0.0
                    },
                    {
                        "offset": 0.5,
                        "color": "rgba(255,255,255,0.5)",
                        "opacity": 0.5
                    },
                    {
                        "offset": 1.0,
                        "color": "#ffffff",
                        "opacity": 1.0
                    }
                ]
            },
            "pivot": {
                "visible": false,
                "note": "Hidden/Transparent as the needle fades out at the base"
            }
        },
        "decorations": {
            "ticks": {
                "visible": true,
                "count": 11,
                "interval": "10%",
                "color": "#ffffff",
                "opacity": 0.1,
                "length": "8px",
                "glow": {
                    "enabled": true,
                    "color": "#ffffff",
                    "opacity": 0.2
                }
            }
        }
    },
    "typography": {
        "primary_score": {
            "font_family": "Segoe UI",
            "weight": "Bold",
            "size": "56px",
            "color": "#ffffff",
            "shadow": {
                "enabled": true,
                "color": "Dynamic (Score Color)",
                "blur": "10px",
                "offset": "(0,0)"
            },
            "position": "Center, just below the arch"
        },
        "status_label": {
            "visible": true,
            "font_family": "Segoe UI",
            "weight": "600",
            "size": "16px",
            "uppercase": true,
            "letter_spacing": "1.5px",
            "position": "Below primary score",
            "dynamic_content": [
                {
                    "threshold": 0,
                    "text": "CRITICAL",
                    "color": "#ff453a"
                },
                {
                    "threshold": 40,
                    "text": "POOR",
                    "color": "#ff453a"
                },
                {
                    "threshold": 60,
                    "text": "FAIR",
                    "color": "#ffd60a"
                },
                {
                    "threshold": 75,
                    "text": "GOOD",
                    "color": "#30d158"
                },
                {
                    "threshold": 90,
                    "text": "EXCELLENT",
                    "color": "#30d158"
                }
            ],
            "glow": {
                "enabled": true,
                "strength": "Moderate"
            }
        }
    },
    "behaviors": {
        "animation": {
            "duration": "1500ms",
            "curve": "OutBack",
            "note": "Overshoot effect for needle"
        },
        "interaction": {
            "hover_glow_boost": true
        }
    }
}